# Qwen3-VL-4B-Instruct with an 8k context window: defined in conditions.yaml, needs about 3.3 GB of model memory.
#   ollama pull qwen3-vl:4b-instruct
#   ollama create qwen3-vl-4b-instruct-8k -f eval/ollama/qwen3-vl-4b-instruct-8k.Modelfile
# (The plain qwen3-vl:4b tag is a thinking model and returns empty answers here: use the -instruct tag.)
FROM qwen3-vl:4b-instruct
PARAMETER num_ctx 8192
