# Qwen3-VL-2B-Instruct with an 8k context window: the model used for the Phase 6 baselines.
#   ollama pull qwen3-vl:2b-instruct
#   ollama create qwen3-vl-2b-instruct-8k -f eval/ollama/qwen3-vl-2b-instruct-8k.Modelfile
# (The plain qwen3-vl:2b tag is a thinking model and returns empty answers here: use the -instruct tag.)
FROM qwen3-vl:2b-instruct
PARAMETER num_ctx 8192
